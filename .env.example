# Neon Postgres (use the *pooled* connection string). Collectors use the owner role;
# the website should use the limited siwes_web role (see db/web_role.sql).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooler) string, used only by scripts/init_db.py. `neon deploy` fills both.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# LLMs (free): Gemini first, NVIDIA NIM as fallback. Either one alone also works.
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Optional model overrides (defaults in config/llm.yaml)
# GEMINI_MODEL=gemini-flash-lite-latest
# NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Optional: Google results via Serper (2,500 free queries, one-time). Without it, ddgs is used.
SERPER_API_KEY=
# Optional: retry blocked pages with a real browser (needs `scrapling install`)
STEALTHY_FETCH=0

# Website
ADMIN_TOKEN=change-me-to-a-long-random-string
CONTACT_EMAIL=
# How many proxies sit in front of the app (Render: 1). 0 = use the socket address.
TRUSTED_PROXY_HOPS=1
